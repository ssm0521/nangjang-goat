# 냉장GOAT 환경변수 템플릿 (복사해서 .env 로 저장 후 실제 값 입력)
# 이 파일은 샘플이며 레포에 커밋됨. 실제 .env 는 커밋 금지(.gitignore 설정됨).

# ─── MySQL ───────────────────────────────────────────
MYSQL_ROOT_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=3306
DB_NAME=naengjang_goat_db
DB_USERNAME=root
DB_PASSWORD=changeme

# ─── JWT (최소 32자 이상 랜덤 문자열) ────────────────
JWT_SECRET=please-replace-with-a-long-random-string

# ─── KAMIS 농산물 공공 API ───────────────────────────
# 발급: https://www.kamis.or.kr/customer/reference/openapi_list.do
KAMIS_API_KEY=
KAMIS_API_ID=

# ─── EKAPE 축산물 공공 API ───────────────────────────
# 발급: https://www.data.go.kr/ (축산물품질평가원 소비자가격)
EKAPE_API_KEY=

# ─── 네이버 쇼핑 API ─────────────────────────────────
# 발급: https://developers.naver.com/apps/#/list
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ─── 모바일 (Expo) ───────────────────────────────────
# 폰에서 접속할 백엔드 주소 (같은 와이파이의 PC IP 또는 adb reverse 시 localhost)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# ─── 웹 프론트 (Vite) ────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080
